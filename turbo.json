{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DISABLE_STRAPI_CMS",
    "STRAPI_URL",
    "STRAPI_API_TOKEN",
    "REQUIRE_STRAPI_API_TOKEN",
    "STRAPI_FETCH_REVALIDATE_SECONDS",
    "REVALIDATE_SECRET",
    "STRAPI_WEBHOOK_SECRET"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
