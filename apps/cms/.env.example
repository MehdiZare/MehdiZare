HOST=0.0.0.0
PORT=1337
IS_BEHIND_PROXY=true
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
# Optional override for users-permissions plugin JWT secret.
# Defaults to JWT_SECRET when unset.
USERS_PERMISSIONS_JWT_SECRET=
ENCRYPTION_KEY=tobemodified

# Comma-separated origins allowed to call the CMS API from browsers.
CORS_ORIGINS="http://localhost:3000,https://mehdi-zare.com, https://www.mehdi-zare.com"

# Cloudflare R2 (S3-compatible upload provider)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_REGION=auto
R2_ROOT_PATH=
R2_SIGNED_URL_EXPIRES=900

# Leave empty for Cloudflare R2 (ACL operations are not supported)
R2_ACL=
