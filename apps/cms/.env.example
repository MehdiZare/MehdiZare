HOST=0.0.0.0
PORT=1337
IS_BEHIND_PROXY=true

# Required in production
APP_KEYS=replace-with-two-or-more-comma-separated-secrets
API_TOKEN_SALT=replace-with-random-secret
ADMIN_JWT_SECRET=replace-with-random-secret
TRANSFER_TOKEN_SALT=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
# Optional override for users-permissions plugin JWT secret.
# Defaults to JWT_SECRET when unset.
USERS_PERMISSIONS_JWT_SECRET=
ENCRYPTION_KEY=replace-with-random-secret

# Optional admin session lifespan overrides (seconds)
# ADMIN_AUTH_ACCESS_TOKEN_LIFESPAN=1800
# ADMIN_AUTH_MAX_REFRESH_TOKEN_LIFESPAN=2592000
# ADMIN_AUTH_IDLE_REFRESH_TOKEN_LIFESPAN=1209600
# ADMIN_AUTH_MAX_SESSION_LIFESPAN=2592000
# ADMIN_AUTH_IDLE_SESSION_LIFESPAN=7200

# Database
DATABASE_CLIENT=sqlite
# Local development default (SQLite is refused when NODE_ENV=production)
DATABASE_FILENAME=.tmp/data.db
# Production (cms-platform, DigitalOcean Managed Postgres). No sslmode in the
# URL: TLS comes from DATABASE_SSL plus the CA (multi-line PEM).
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>
# DATABASE_SSL=true
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----..."
# DATABASE_POOL_MAX=3

# Refuse to boot when the database has no admin user (set in production)
# REQUIRE_EXISTING_ADMIN=true

# Public URL for absolute admin and upload links (production)
# URL=https://cms.svc.mehdi-zare.com

# Cloudflare R2 uploads (see R2_SETUP.md). Unset = local uploads.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://media.mehdi-zare.com
# R2_ROOT_PATH=media

# CORS
# Local development default
CORS_ORIGINS=http://localhost:3000
# Production default
# CORS_ORIGINS=https://www.mehdi-zare.com,https://mehdi-zare.com
