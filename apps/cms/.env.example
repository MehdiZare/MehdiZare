HOST=0.0.0.0
PORT=1337
IS_BEHIND_PROXY=true

# Required in production
APP_KEYS=replace-with-two-or-more-comma-separated-secrets
API_TOKEN_SALT=replace-with-random-secret
ADMIN_JWT_SECRET=replace-with-random-secret
TRANSFER_TOKEN_SALT=replace-with-random-secret
JWT_SECRET=replace-with-random-secret
# Optional override for users-permissions plugin JWT secret.
# Defaults to JWT_SECRET when unset.
USERS_PERMISSIONS_JWT_SECRET=
ENCRYPTION_KEY=replace-with-random-secret

# Database
DATABASE_CLIENT=sqlite
# Local development default
DATABASE_FILENAME=.tmp/data.db
# Railway production default (volume-backed)
# DATABASE_FILENAME=/data/cms.db

# CORS
# Local development default
CORS_ORIGINS=http://localhost:3000
# Production default
# CORS_ORIGINS=https://www.mehdi-zare.com,https://mehdi-zare.com
