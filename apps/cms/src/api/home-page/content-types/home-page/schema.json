{
  "kind": "singleType",
  "collectionName": "home_pages",
  "info": {
    "singularName": "home-page",
    "pluralName": "home-pages",
    "displayName": "Home Page",
    "description": "Not read by the website. Page copy and site identity live in the repo (apps/web/src/content/fallbacks/ and src/lib/site-profile-defaults.ts). Editing this has no effect on the live site. Articles, categories, tags and the Author record ARE read from here."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "heroHeadline": {
      "type": "string"
    },
    "heroSubheadline": {
      "type": "text"
    },
    "heroPrimaryCtaLabel": {
      "type": "string"
    },
    "heroPrimaryCtaHref": {
      "type": "string"
    },
    "heroSecondaryCtaLabel": {
      "type": "string"
    },
    "heroSecondaryCtaHref": {
      "type": "string"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "credibilityItems": {
      "type": "component",
      "repeatable": true,
      "component": "home.credibility-item"
    },
    "featuredOnItems": {
      "type": "component",
      "repeatable": true,
      "component": "home.featured-on-item"
    },
    "whatIDoCards": {
      "type": "component",
      "repeatable": true,
      "component": "home.value-card"
    },
    "newsletterHeadline": {
      "type": "string"
    },
    "newsletterCopy": {
      "type": "text"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
