{
  "kind": "singleType",
  "collectionName": "about_pages",
  "info": {
    "singularName": "about-page",
    "pluralName": "about-pages",
    "displayName": "About Page",
    "description": "Not read by the website. Page copy and site identity live in the repo (apps/web/src/content/fallbacks/ and src/lib/site-profile-defaults.ts). Editing this has no effect on the live site. Articles, categories, tags and the Author record ARE read from here."
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string"
    },
    "positioningStatement": {
      "type": "text"
    },
    "bio": {
      "type": "blocks"
    },
    "stats": {
      "type": "component",
      "repeatable": true,
      "component": "shared.stat"
    },
    "credentials": {
      "type": "component",
      "repeatable": true,
      "component": "shared.credential"
    },
    "experiences": {
      "type": "component",
      "repeatable": true,
      "component": "shared.experience"
    },
    "education": {
      "type": "component",
      "repeatable": true,
      "component": "shared.education"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
