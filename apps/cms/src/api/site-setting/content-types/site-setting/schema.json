{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Site Settings",
    "description": "Not read by the website. Page copy and site identity live in the repo (apps/web/src/content/fallbacks/ and src/lib/site-profile-defaults.ts). Editing this has no effect on the live site. Articles, categories, tags and the Author record ARE read from here."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "siteName": {
      "type": "string"
    },
    "siteDescription": {
      "type": "text"
    },
    "positioningHeadline": {
      "type": "string"
    },
    "positioningSubheadline": {
      "type": "text"
    },
    "positioningHighlight": {
      "type": "string"
    },
    "credentialLine": {
      "type": "string"
    },
    "industriesLine": {
      "type": "string"
    },
    "locationLine": {
      "type": "string"
    },
    "primaryCtaLabel": {
      "type": "string"
    },
    "primaryCtaHref": {
      "type": "string"
    },
    "secondaryCtaLabel": {
      "type": "string"
    },
    "secondaryCtaHref": {
      "type": "string"
    },
    "newsletterTitle": {
      "type": "string"
    },
    "newsletterOneLiner": {
      "type": "text"
    },
    "contactPrompt": {
      "type": "string"
    },
    "authorName": {
      "type": "string"
    },
    "authorRole": {
      "type": "string"
    },
    "authorBioShort": {
      "type": "text"
    },
    "footerText": {
      "type": "text"
    },
    "bookCallHref": {
      "type": "string"
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "shared.social-link"
    },
    "navItems": {
      "type": "component",
      "repeatable": true,
      "component": "shared.nav-item"
    },
    "defaultSeo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
