NEXT_PUBLIC_SITE_URL=https://mehdi-zare.com
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
STRAPI_API_TOKEN=your-strapi-api-token-here
REQUIRE_STRAPI_API_TOKEN=false
DISABLE_STRAPI_CMS=true

# Optional: comma-separated hostnames for remote images
# Example: cdn.example.com,images.ctfassets.net
NEXT_PUBLIC_ALLOWED_IMAGE_HOSTS=

# Beehiiv embed URL (public)
NEXT_PUBLIC_BEEHIIV_EMBED_URL=

# PostHog analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
