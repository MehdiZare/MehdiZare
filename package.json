{
  "name": "mehdi-zare-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "dev:web": "turbo dev --filter=web",
    "dev:cms": "turbo dev --filter=cms",
    "typecheck": "pnpm --filter=web exec tsc --noEmit",
    "test": "pnpm --filter=web test",
    "prepare": "[ -d .git ] && husky || true"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.10.11"
  },
  "packageManager": "pnpm@11.23.0+sha512.8ACC5bKDoZm3Tgedoo0VXACP4jL0TIoG6n3foBTs9xn8Ni95DsxnsoEG3awq+yTEmpoHkVnaVgss59Hpjv0Rrw=="
}
